PORT=3000
# Nhieu bao tang tren mot may: KHONG dung file nay cho bao tang moi - moi bao tang
# co .env rieng trong thu muc du lieu cua no, tao bang scripts/tao-bao-tang.js
# (xem NHIEU_BAO_TANG.md).
# Cong mo ra may chu khi chay `docker compose up` (mac dinh 3000).
# HOST_PORT=3000
JWT_SECRET=change-this-to-a-strong-secret

# May dev de trong (mac dinh 0.0.0.0, van vao duoc qua LAN de test tren dien
# thoai/tablet). Server that dung sau reverse proxy (nginx/Caddy, co TLS) BAT
# BUOC dat = 127.0.0.1, neu khong port Node se lo thang ra ngoai song song voi
# nginx, di vong qua TLS - xem CLAUDE.md muc 5.1/5.8.
BIND_HOST=

# Tai khoan Chu DAU TIEN. Chi dung DUNG MOT LAN: lan dang nhap dau tien, server
# tao users.json tu 2 dong nay roi tu do KHONG doc lai nua (xem CLAUDE.md 5.16).
# Sua 2 dong nay sau do se khong co tac dung gi - doi mat khau trong trang admin.
# Tao ADMIN_PASSWORD_HASH bang: node -e "console.log(require('bcryptjs').hashSync('mat-khau-cua-ban', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ---- Gui thu (ma quen mat khau cua tai khoan Chu, thu bao bao mat) ----
# NEN DUNG: de TRONG ca ba dong MAIL_* ben duoi, roi tai khoan Chu cai ngay trong CMS:
#   Quan ly tai khoan > "Gui thu cua he thong" (chi Gmail + mat khau ung dung).
# Chi dien MAIL_* khi muon KHOA cau hinh Brevo tu may chu - khi do CMS chi hien, khong
# cho sua. Chua cai gi thi tinh nang tat han va giao dien noi ro; quen mat khau van
# con duong: tai khoan Chu con lai dat lai giup - vi the luon nen co HAI tai khoan Chu.
#
# Lay khoa o Brevo (mien phi 300 thu/ngay): Settings > SMTP & API > API Keys.
# MAIL_FROM phai la dia chi da xac minh ben Brevo (Senders), neu khong thu bi tu choi.
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Beacon Admin

# Ten hien trong ung dung xac thuc (Google/Microsoft Authenticator) canh ma 6 so.
# De trong = ten bao tang (sua trong CMS: Giao dien ung dung > Ten bao tang).
# Chi anh huong ma QR sinh ra TU LUC DOI tro di.
TOTP_ISSUER=
# Doi nha cung cap khac (Mailin/Sendinblue cu, hoac proxy noi bo) thi sua dong nay.
# MAIL_API_URL=https://api.brevo.com/v3/smtp/email

# Duong dan Chromium de DUNG DAI ANH XOAY 360 + anh giu cho cho mo hinh 3D
# (turntableRenderer.js). De trong = tu tim chromium / chromium-browser /
# google-chrome-stable tren PATH. Server Alpine: `apk add chromium`.
# THIEU Chromium thi mo hinh 3D van chay, chi khong co lop xoay tuc thi -
# giao dien Mo hinh 3D se noi ro.
CHROME_BIN=

# Mui gio cua bao tang - dung de chia NGAY/THANG trong bao cao thong ke.
# VPS thuong chay gio UTC; de trong = Asia/Ho_Chi_Minh.
MUSEUM_TZ=
