# Backup code he LEGACY da xoa (xem CLAUDE.md muc 1) - giu tren dia lam luoi an
# toan, khong can lich su git.
.legacy-backup-*/

# Media va backup noi bo cua content/: nang (co the len GB), khong hop de trong
# git. RIENG manifest.json thi CO theo doi - do la thu that su hay thay doi va
# la cai can biet "ai doi gi luc nao" khi debug.
content/images/
content/audio/
content/.import-backups/
content/.language-backups/
content/.analytics/
content/.history/

# Mo hinh 3D (.glb) + dai anh xoay - nhi phan, nang, cung loai voi images/audio.
# Duoc scripts/backup-content.sh sao luu.
content/models/
content/turntable/

# 17MB mp4/mp3 mo coi tu he LEGACY - da grep: KHONG code nao con tham chieu
# toi public/videos/. Giu tren dia thi vo hai, nhung khong dua vao git.
public/videos/

# Kho tai khoan quan tri (chua hash mat khau) - KHONG commit
users.json
users.json.tmp-*

