mail.json
mail.json.tmp-*
account-audit.ndjson

# Goi phat hanh Docker (scripts/package-docker.sh) - dung lai duoc, khong dua vao git.
dist/

# Ban gop ma nguon 1 file (Repomix...) de dua cho cong cu review - nang (vai MB), sinh
